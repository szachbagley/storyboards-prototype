# Server environment. Copy to server/.env and fill in.
# Application constants (model IDs, aspect ratio, concept caps, poll interval)
# are NOT here -- they live in shared/src/config.ts. See TECH_SPEC.md 11.

# --- required from phase 1 ---
DATABASE_URL=postgres://postgres:postgres@localhost:5433/storyboards
DATABASE_SSL=false          # true for Railway's external connection string
APP_SECRET=dev-secret-change-me
PORT=3001

# --- required from phase 2 (S3) ---
# Credentials belong to the dedicated storyboards-server IAM user, which is
# scoped to object operations on this one bucket. Do not use root keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# --- required from phase 3 (Gemini) ---
GEMINI_API_KEY=

# --- client; copy to client/.env.local ---
VITE_API_BASE_URL=http://localhost:3001
